{
  "name": "studio-framer-project",
  "version": "1.0.0",
  "description": "A modern web application built with Studio Framer",
  "main": "index.js",
  "types": "_studio-frame/types.d.ts",
  "type": "module",
  "scripts": {
    "start": "node _studio-frame/server.js",
    "dev": "node _studio-frame/server.js",
    "build": "node _studio-frame/build.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky install"
  },
  "keywords": [
    "studio-framer",
    "vdom",
    "framework"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "esbuild": "^0.27.3",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  }
}
